#include <windows.h>
LANGUAGE LANG_ENGLISH, SUBLANG_ENGLISH_US
101 ICON "@CMAKE_SOURCE_DIR@/resources/Six6.ico"
102 RCDATA "@CMAKE_SOURCE_DIR@/resources/FluentUI-NOTICES.txt"
1 RT_MANIFEST "@CMAKE_CURRENT_BINARY_DIR@/KBeditor.manifest"
1 VERSIONINFO
 FILEVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 PRODUCTVERSION @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,@PROJECT_VERSION_TWEAK@
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Author", "sclliang\0"
            VALUE "CompanyName", "sixunited\0"
            VALUE "FileDescription", "Keyboard Layout Editor\0"
            VALUE "FileVersion", "@PROJECT_VERSION@\0"
            VALUE "InternalName", "KBeditor\0"
            VALUE "LegalCopyright", "Copyright (c) 2026 sixunited. Author: sclliang\0"
            VALUE "OriginalFilename", "KBeditor.exe\0"
            VALUE "ProductName", "KBeditor\0"
            VALUE "ProductVersion", "@PROJECT_VERSION@\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
